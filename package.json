{
  "name": "privacylens",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "eval"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:browser": "tsx eval/browser-test.ts",
    "eval": "tsx eval/runner/index.ts",
    "package": "node scripts/package-extension.js",
    "gateway": "npm --workspace=@privacylens/gateway run dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
