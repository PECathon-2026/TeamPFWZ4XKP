{
  "name": "privacylens",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "eval"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "eval": "tsx eval/runner/index.ts",
    "gateway": "npm --workspace=@privacylens/gateway run dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3"
  }
}
