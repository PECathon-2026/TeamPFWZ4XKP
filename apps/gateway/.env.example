# ========================================================
# PrivacyLens AI Gateway Configuration (NVIDIA Nemotron)
# ========================================================

# 1. Active Reasoner Provider
PROVIDER=nemotron

# 2. NVIDIA Nemotron API Configuration
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvapi_key_here

# 3. Model Name
# Default: nvidia/llama-3.1-nemotron-70b-instruct
# Other options:
#   - nvidia/nemotron-4-340b-instruct
#   - nvidia/nemotron-mini-4b-instruct
#   - nvidia/llama-3.1-nemotron-51b-instruct
MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# 4. Base URL (default is NVIDIA NIM integrate endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 5. Server Port & Mode
PORT=8787
NODE_ENV=development

# 6. Gateway Auth Token
# Set if you require the extension to send a specific Bearer token.
# Leave empty for local development without token enforcement.
GATEWAY_AUTH_TOKEN=

